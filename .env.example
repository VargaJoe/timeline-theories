# Local Docker app: copy this file to .env, then run:
# docker compose -f compose.local.yaml up -d --build
# .env is gitignored and excluded from Docker builds. Never commit actual
# foreign/private repository settings or secrets; change only your .env.
# These public defaults refer ONLY to Timeline Theories' own local SenseNet.
TIMELINE_DOCKER_PROFILE=m0-local
VITE_SENSENET_REPO_URL=https://localhost:41016
VITE_OIDC_AUTHORITY=https://localhost:41017
# Empty uses the public client ID generated by the existing M0 setup.
VITE_OIDC_CLIENT_ID=
VITE_AUTH_TYPE=oidc
VITE_PROJECT_ROOT_PATH=/Root/Content/timelines
VITE_READ_ONLY=false

# Container-to-host bridge; browser/auth origins above stay HTTPS localhost.
TIMELINE_DOCKER_HOST=host.docker.internal

# For a different repository, use development (or production-readonly) and set
# BOTH actual HTTPS origins, public client ID and project path in private .env.
# Optional provider keys are SERVER ONLY. Never name private values VITE_*.
# TRAKT_API_KEY=
# OMDB_API_KEY=
# TMDB_API_KEY=
