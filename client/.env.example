# M0 frontend uses validated public JSON profiles, not legacy .env files.
# npm run dev selects client/profiles/local.json + ignored local.override.json.
# Bootstrap creates the public local SPA client ID override automatically.
# npm run dev:readonly explicitly selects production-readonly.json.
# Full restart is required after changing profile/process configuration.
# Optional process overrides below are public HTTPS origin URLs only.
# TIMELINE_REPOSITORY_URL=https://localhost:41016
# TIMELINE_AUTHORITY=https://localhost:41017
# Never put API keys, client secrets, passwords or tokens in a frontend profile.
