# npm run dev/build use standard Vite .env precedence. Hosting process variables win.
# Set BOTH origins for the repository you intend to use; there is no implicit target.
VITE_SENSENET_REPO_URL=https://your-repository.sensenet.cloud
VITE_OIDC_AUTHORITY=https://your-auth.sensenet.cloud
VITE_OIDC_CLIENT_ID=your-public-spa-client-id
VITE_PROJECT_ROOT_PATH=/Root/Content/timelines
# auto discovers only the provider type; it never replaces the configured origins.
# Supported explicit values: sn-auth, oidc, SNAuth, IdentityServer.
VITE_AUTH_TYPE=auto
VITE_READ_ONLY=false

# npm run dev:m0 explicitly selects the isolated M0 localhost runtime and generated
# public SPA client ID. It neither reads nor overwrites your .env files.
# Restart/rebuild after changing environment settings.
# Browser env is a public-field allowlist: API keys, passwords, client secrets and
# tokens (including legacy VITE_SENSENET_API_KEY/VITE_TRAKT_API_KEY) are not exposed.
