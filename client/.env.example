# Example environment file for TimelineVerse project
# Copy to .env and adjust as needed for your environment

# SenseNet repository root path (default: /Root/Content)
VITE_PROJECT_ROOT_PATH=/Root/Content

# Relative paths to API keys in SenseNet ECM
VITE_OMDB_KEY_PATH=/(structure)/apikeys/omdb
VITE_TMDB_KEY_PATH=/(structure)/apikeys/tmdb
VITE_TRAKT_KEY_PATH=/(structure)/apikeys/trakt

# SenseNet repository URL
VITE_SENSENET_REPO_URL=https://your-sensenet-repo-url

# OIDC Identity Server Configuration
VITE_OIDC_CLIENT_ID=your-client-id
VITE_OIDC_AUTHORITY=https://your-identity-server-url

# Trakt API Key (direct key, not path)
VITE_TRAKT_API_KEY=your-trakt-api-key

# Assets base path (relative to project root)
VITE_ASSETS_BASE_PATH=/(structure)/style

# Site configuration
VITE_SITE_TITLE=Timeline Theories
VITE_HEADER_BACKGROUND_IMAGE=background.webp
VITE_HEADER_OVERLAY_OPACITY=0.3

# Admin emails (comma-separated)
VITE_ADMIN_EMAILS=admin@example.com

# Maintenance mode (set to 'true' to enable)
VITE_MAINTENANCE_MODE=false

# Image loading optimization settings
VITE_IMAGE_CONCURRENCY_LIMIT=2
VITE_LOCAL_STORAGE_TTL=3600000

# "All" timeline view settings
VITE_ALL_TIMELINE_PAGE_SIZE=20
VITE_ENABLE_ALL_TIMELINE_VIEW=true
VITE_ENABLE_ABC_PAGINATION=true

# Use local test Trakt list JSON for development (set to 'true' to enable)
# VITE_USE_TEST_TRAKT_LIST=true