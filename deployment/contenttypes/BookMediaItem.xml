<ContentType name="BookMediaItem" parentType="MediaItem" handler="SenseNet.ContentRepository.GenericContent" xmlns="http://schemas.sensenet.com/SenseNet/ContentRepository/ContentTypeDefinition">
  <DisplayName>BookMediaItem</DisplayName>
  <Description>A book media item with book-specific metadata.</Description>
  <Icon>Content</Icon>
  <AllowIncrementalNaming>true</AllowIncrementalNaming>
  <AllowedChildTypes></AllowedChildTypes>
  <Fields>
    <Field name="Author" type="ShortText">
      <DisplayName>Author</DisplayName>
      <Description>Book author(s)</Description>
      <Configuration>
        <VisibleBrowse>Show</VisibleBrowse>
        <VisibleEdit>Show</VisibleEdit>
        <VisibleNew>Show</VisibleNew>
      </Configuration>
    </Field>
    <Field name="Publisher" type="ShortText">
      <DisplayName>Publisher</DisplayName>
      <Description>Book publisher</Description>
      <Configuration>
        <VisibleBrowse>Show</VisibleBrowse>
        <VisibleEdit>Show</VisibleEdit>
        <VisibleNew>Show</VisibleNew>
      </Configuration>
    </Field>
    <Field name="ISBN" type="ShortText">
      <DisplayName>ISBN</DisplayName>
      <Description>International Standard Book Number</Description>
      <Configuration>
        <VisibleBrowse>Show</VisibleBrowse>
        <VisibleEdit>Show</VisibleEdit>
        <VisibleNew>Show</VisibleNew>
      </Configuration>
    </Field>
    <Field name="PublicationYear" type="Integer">
      <DisplayName>Publication Year</DisplayName>
      <Description>Year the book was published</Description>
      <Configuration>
        <MinValue>1000</MinValue>
        <MaxValue>2100</MaxValue>
        <VisibleBrowse>Show</VisibleBrowse>
        <VisibleEdit>Show</VisibleEdit>
        <VisibleNew>Show</VisibleNew>
      </Configuration>
    </Field>
    <Field name="BookSeriesNumber" type="Integer">
      <DisplayName>Book Series Number</DisplayName>
      <Description>Position in numbered series (e.g., 3 for book 3 in a series)</Description>
      <Configuration>
        <VisibleBrowse>Show</VisibleBrowse>
        <VisibleEdit>Show</VisibleEdit>
        <VisibleNew>Show</VisibleNew>
      </Configuration>
    </Field>
  </Fields>
</ContentType>